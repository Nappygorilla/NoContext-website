# PostgreSQL connection string. For local development you can omit this and use SQLite.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Exact HTTPS origin of the GitHub Pages frontend.
FRONTEND_ORIGIN=https://nappygorilla.github.io

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Public free-key lifetimes.
FREE_KEY_DAYS=3
BOOSTER_KEY_DAYS=7

# GitHub Pages URL users return to after Discord verification.
FRONTEND_URL=https://nappygorilla.github.io/NoContext-website/key.html

# Discord OAuth + server-side booster verification.
# Create an OAuth2 application/bot and keep the secret/token ONLY on the backend.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Must exactly match a Redirect URI registered in Discord Developer Portal.
DISCORD_LOGIN_REDIRECT_URI=https://nocontext.onrender.com/api/auth/discord/callback
# DISCORD_REDIRECT_URI is also accepted for backwards compatibility.
OAUTH_STATE_SECRET=

# KeyAuth tester-account mode.
# Licenses are created in the KeyAuth dashboard and then imported into NoContext.
# No Seller API key is required for this mode.

# NoContext-Keys GitHub synchronization.
# This repo is public, so ONLY SHA-256 key hashes are synchronized, never plaintext keys.
NOCONTEXT_KEYS_GITHUB_REPO=Nappygorilla/NoContext-Keys
NOCONTEXT_KEYS_GITHUB_BRANCH=main
NOCONTEXT_KEYS_GITHUB_TOKEN=
# Background cleanup/sync interval in seconds (minimum 60).
NOCONTEXT_KEYS_SYNC_INTERVAL=300
